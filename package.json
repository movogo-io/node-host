{
  "name": "@movogo-io/host",
  "version": "0.4.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/movogo-io/node-host.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "riddance",
    "serverless",
    "environment",
    "devenv",
    "opinionated"
  ],
  "files": [
    "*.js",
    "*.d.ts",
    "host/*.js",
    "host/*.d.ts"
  ],
  "sideEffects": [
    "./host/context.js",
    "./host/http-registry.js",
    "./host/event-registry.js",
    "./host/timer-registry.js"
  ],
  "exports": {
    "./lib/context": "./context.js",
    "./lib/http": "./http.js",
    "./lib/timer": "./timer.js",
    "./lib/event": "./event.js",
    "./registry": "./host/registry.js",
    "./reflect": "./host/reflect.js",
    "./logging": "./host/logging.js",
    "./context": "./host/context.js",
    "./http": "./host/http.js",
    "./http-registry": "./host/http-registry.js",
    "./timer": "./host/timer.js",
    "./timer-registry": "./host/timer-registry.js",
    "./event": "./host/event.js",
    "./event-registry": "./host/event-registry.js",
    "./attributes": "./host/attributes.js",
    "./attribution": "./host/attribution.js"
  },
  "scripts": {
    "start": "riddance-watch",
    "prepack": "riddance-build",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  },
  "devDependencies": {
    "@riddance/env": "0.10.2"
  },
  "allowScripts": {
    "@riddance/env": true
  }
}
